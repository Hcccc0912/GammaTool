<UserControl x:Class="Gato.Controls.LutPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="256" Height="160">
    <Canvas x:Name="Plot" Width="256" Height="160" Background="#000000" ClipToBounds="True">
        <Polyline x:Name="RedCurve" Stroke="#E81123" StrokeThickness="1.5" />
        <Polyline x:Name="GreenCurve" Stroke="#16C60C" StrokeThickness="1.5" />
        <Polyline x:Name="BlueCurve" Stroke="#0078D7" StrokeThickness="1.5" />
    </Canvas>
</UserControl>

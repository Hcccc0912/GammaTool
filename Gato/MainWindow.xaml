<ui:FluentWindow x:Class="Gato.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
                 xmlns:controls="clr-namespace:Gato.Controls"
                 Title="Gato" Width="760" Height="560" MinWidth="720" MinHeight="520"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowCornerPreference="Round" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <tray:NotifyIcon x:Name="GatoTrayIcon" Grid.RowSpan="2" Width="0" Height="0"
                         Visibility="Collapsed" IsHitTestVisible="False" TooltipText="Gato"
                         FocusOnLeftClick="False" MenuOnRightClick="True"
                         Icon="pack://application:,,,/Resources/app.ico" />
        <ui:TitleBar Grid.Row="0" Title="Gato">
            <ui:TitleBar.TrailingContent>
                <Button Content="Hide" Padding="10,4" Click="Hide_Click" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <ListBox x:Name="ProfileListBox" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                 DisplayMemberPath="Name" MinHeight="120">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Height" Value="32" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="No profiles. Create one to get started." HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Profiles.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,8">
                        <Button Margin="2" ToolTip="New profile" Click="NewProfile_Click"><ui:SymbolIcon Symbol="Add24" /></Button>
                        <Button Margin="2" ToolTip="Save as..." Click="SaveAs_Click"><ui:SymbolIcon Symbol="Save24" /></Button>
                        <Button Margin="2" ToolTip="Delete" Click="DeleteProfile_Click"><ui:SymbolIcon Symbol="Delete24" /></Button>
                    </UniformGrid>
                    <!-- Hotkey controls are in the right pane header. -->
                    <Grid Grid.Row="2" Margin="2,0,2,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hot-key" VerticalAlignment="Center" />
                        <TextBox x:Name="LegacyHotkeyTextBox" Grid.Column="1" IsReadOnly="True" Text="Set hotkey"
                                 PreviewMouseDown="Hotkey_PreviewMouseDown" PreviewKeyDown="Hotkey_PreviewKeyDown"
                                 PreviewKeyUp="Hotkey_PreviewKeyUp" />
                        <Button Grid.Column="2" Content="×" Padding="5,0" Margin="3,0,0,0" ToolTip="Clear hotkey" Click="ClearHotkey_Click" />
                    </Grid>
                    <StackPanel Grid.Row="3">
                        <Separator Margin="0,4,0,8" />
                        <ui:ToggleSwitch x:Name="LaunchOnStartupSwitch" Content="Launch at startup"
                                         IsChecked="{Binding Config.LaunchOnStartup, Mode=TwoWay}"
                                         Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="200" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProfileNameTextBox" Width="210" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                             Padding="8,4" ToolTip="Profile name; saved automatically when editing ends"
                             LostFocus="ProfileName_LostFocus" KeyDown="ProfileName_KeyDown" />
                    <Grid Grid.Column="1" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyTextBox" IsReadOnly="True" Text="Set hotkey"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="8,4"
                                 PreviewMouseDown="Hotkey_PreviewMouseDown" PreviewKeyDown="Hotkey_PreviewKeyDown"
                                 PreviewKeyUp="Hotkey_PreviewKeyUp" />
                        <Button Grid.Column="1" Content="×" Padding="8,2" Margin="4,0,0,0" ToolTip="Clear hotkey" Click="ClearHotkey_Click" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Width="36" Height="32" ToolTip="Reset current channel" Click="Reset_Click"><ui:SymbolIcon Symbol="ArrowCounterclockwise24" /></Button>
                    <ToggleButton x:Name="LinkedToggle" Content="Linked" Margin="8,0,0,0" Padding="12,4"
                                  Checked="Linked_Changed" Unchecked="Linked_Changed" />
                    <RadioButton x:Name="RedChannelRadio" Tag="Red" GroupName="Channel" IsChecked="True" IsEnabled="{Binding IsUnlinked}"
                                 Margin="16,0,4,0" VerticalAlignment="Center" Checked="Channel_Checked">
                        <StackPanel Orientation="Horizontal"><Rectangle Width="8" Height="8" Fill="#E81123" Margin="0,0,4,0" /><TextBlock Text="Red" /></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Green" GroupName="Channel" IsEnabled="{Binding IsUnlinked}"
                                 Margin="4,0" VerticalAlignment="Center" Checked="Channel_Checked">
                        <StackPanel Orientation="Horizontal"><Rectangle Width="8" Height="8" Fill="#16C60C" Margin="0,0,4,0" /><TextBlock Text="Green" /></StackPanel>
                    </RadioButton>
                    <RadioButton Tag="Blue" GroupName="Channel" IsEnabled="{Binding IsUnlinked}"
                                 Margin="4,0" VerticalAlignment="Center" Checked="Channel_Checked">
                        <StackPanel Orientation="Horizontal"><Rectangle Width="8" Height="8" Fill="#0078D7" Margin="0,0,4,0" /><TextBlock Text="Blue" /></StackPanel>
                    </RadioButton>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="Gamma&#10;0.5 ~ 4.0" FontSize="11" VerticalAlignment="Center" />
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="4.0" TickFrequency="0.01" IsSnapToTickEnabled="False"
                            Value="{Binding Gamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Gamma, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="Brightness&#10;-128 ~ 128" FontSize="11" VerticalAlignment="Center" />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="-128" Maximum="128" TickFrequency="1"
                            Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Brightness}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="2" Text="Contrast&#10;0.5 ~ 2.0" FontSize="11" VerticalAlignment="Center" />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0.5" Maximum="2.0" TickFrequency="0.01"
                            Value="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Contrast, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <controls:LutPreview x:Name="LutGraph" />
                    <TextBlock x:Name="ColorCountText" Text="LUT: 16,777,216 / 16,777,216"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Monitors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Height="32" Padding="8,0" VerticalContentAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No monitors detected" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Monitors.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
